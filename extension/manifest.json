{
  "manifest_version": 3,
  "name": "cvhelper",
  "version": "0.1.0",
  "description": "Puts the right CV into a job application form, from your local cvhelper.",
  "action": { "default_popup": "popup.html", "default_title": "cvhelper" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}
